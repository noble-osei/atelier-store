# Copy this file to .env.local and fill in the values.

# Neon Postgres connection string (Neon dashboard -> Connect).
# Use the pooled connection string for the app.
DATABASE_URL=""

# Better Auth
# Generate a secret with: npx auth@1.7.10 secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app
BETTER_AUTH_URL=""

STRIPE_SECRET_KEY=""

# Stripe webhook signing secret (starts with whsec_). See "How to get it" in the notes.
STRIPE_WEBHOOK_SECRET=""

# Any long random string. Your scheduler sends it as "Authorization: Bearer <value>".
CRON_SECRET=""
